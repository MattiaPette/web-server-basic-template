{
  "openapi": "3.0.3",
  "info": {
    "title": "Web Server Basic Template API",
    "version": "1.0.0",
    "description": "API di esempio per un server Express con validazione Zod. Risorse: users, teachers, classes, rubrica. I dati sono in memoria: lo stato si azzera a ogni riavvio del server.",
    "contact": {
      "name": "Web Server Basic Template"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Server di sviluppo locale"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "Gestione utenti"
    },
    {
      "name": "Teachers",
      "description": "Gestione insegnanti"
    },
    {
      "name": "Classes",
      "description": "Gestione classi"
    },
    {
      "name": "Rubrica",
      "description": "Gestione rubrica contatti"
    }
  ],
