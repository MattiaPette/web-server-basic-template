  "components": {
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificativo numerico della risorsa",
        "schema": {
          "type": "string",
          "pattern": "^\\d+$"
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "Utente restituito dalle API",
        "required": ["id", "name", "surname", "email"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo univoco",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Mario"
          },
          "surname": {
            "type": "string",
            "example": "Rossi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "age": {
            "type": "integer",
            "minimum": 1,
            "example": 30
          }
        }
      },
      "CreateUserInput": {
        "type": "object",
        "description": "Payload per la creazione di un utente",
        "required": ["name", "surname", "email"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Mario"
          },
          "surname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Rossi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "age": {
            "type": "integer",
            "minimum": 1,
            "example": 30
          }
        }
      },
      "UpdateUserInput": {
        "type": "object",
        "description": "Payload per l'aggiornamento di un utente. Tutti i campi sono opzionali.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Mario"
          },
          "surname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Rossi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "age": {
            "type": "integer",
            "minimum": 1,
            "example": 30
          }
        }
      },
      "Teacher": {
        "type": "object",
        "description": "Insegnante restituito dalle API",
        "required": ["id", "name", "surname", "email", "subject"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo univoco",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Anna"
          },
          "surname": {
            "type": "string",
            "example": "Verdi"
          },
