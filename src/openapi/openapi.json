        "tags": ["Rubrica"],
        "summary": "Search a contact by email",
        "description": "Cerca un contatto nella rubrica in base all'email. Se nessun contatto corrisponde restituisce un oggetto vuoto.",
        "operationId": "searchRubrica",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": false,
            "description": "Email del contatto da cercare",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contatto trovato (o oggetto vuoto se assente)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Rubrica"
                    },
                    {
                      "type": "object",
